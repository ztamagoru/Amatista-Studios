~ start
if first_time_dialog:
	set first_time_dialog = false

	NPC: Hola...
	NPC: Necesito pedirte un favor.
	=> quest
else:
	if are_all_quests_completed():
		=> completed
	elif current_subquest == null:
		=> quest
	elif has_flower():
		do complete_quest()
		=> thankful
	else:
		=> quest_explanation

# --

~ quest
do give_next_quest()

NPC: Hay algo que necesito de vos.
NPC: Estoy buscando una flor en particular.
NPC: {{get_current_flower_hint()}}
NPC: Si llegás a encontrarla, traémela.
=> END

~ quest_explanation
NPC: ¿Todavía no encontraste la flor?
NPC: {{get_current_flower_hint()}}
NPC: Fijate bien por los alrededores.
=> END

~ thankful
NPC: ¡La encontraste!
NPC: Muchas gracias.
NPC: Me es de mucha ayuda.
=> END

~ completed
NPC: Ya me ayudaste con todas las flores que necesitaba.
NPC: Te estoy muy agradecido.
=> END